# Copy thành .env rồi điền nếu muốn dùng model thật / Langfuse cloud.
# Không điền gì vẫn chạy được toàn bộ ví dụ ở chế độ offline.

# Chỉ dùng cho bài 05 (LLM-as-judge). Thiếu key thì dùng judge giả lập.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tuỳ chọn cho bài 02. Thiếu key hoặc thiếu package đều fallback local.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
