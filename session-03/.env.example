# Copy thành .env nếu bạn muốn dùng model thật ở phần mở rộng.
# Sáu ví dụ của buổi 3 KHÔNG đọc file này và không cần key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Chỉ dùng khi chạy MCP server qua HTTP (không bắt buộc cho buổi này).
# Đây là ví dụ về tên biến, không phải token thật.
MCP_BEARER_TOKEN=
MCP_ROLE=viewer
