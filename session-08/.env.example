# Buổi 8 chạy hoàn toàn offline: không cần API key, không cần dịch vụ ngoài.
# Giữ FAKE=1 để nhắc rằng mọi model trong bài đều là model giả lập.
FAKE=1

# Chỉ dùng khi bạn tự cắm model thật vào bài tập nâng cao (không bắt buộc).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Nơi ghi audit log. Để trống thì dùng thư mục tạm của hệ điều hành.
AUDIT_LOG_PATH=
